FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    PIP_DEFAULT_TIMEOUT=120 PIP_RETRIES=8
COPY requirements.txt ./
# Longer timeout helps slow connections. It does not solve blocked DNS/proxy/firewall.
RUN python -m pip install --no-cache-dir -r requirements.txt
COPY bank/ ./bank/
COPY gateway/ ./gateway/
COPY bonus/ ./bonus/
COPY client.py ./client.py
COPY scripts/migrate_recovery_schema.py ./scripts/migrate_recovery_schema.py
RUN useradd -u 10001 --create-home bankapp
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "gateway.entrypoint_k8s"]
